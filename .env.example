# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. Safe to expose in the browser because
# Row Level Security protects the data. NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The public address of the deployed site (no trailing slash). Used to build
# invitation links such as https://your-domain.com/invite/A8F32K
# If left empty the address you are browsing from is used.
VITE_SITE_URL=https://your-domain.com
